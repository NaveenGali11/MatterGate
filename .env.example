# Copy to .env. No credentials are required for fixture mode.
MATTERGATE_DATABASE=data/mattergate.sqlite3
# Set a random session secret for persistent sessions across restarts.
MATTERGATE_SESSION_SECRET=
NEBIUS_API_KEY=
# Official Nebius Nemotron notebook example, checked 2026-10-24; confirm account availability.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
MODEL_TIMEOUT_SECONDS=45
MODEL_MAX_OUTPUT_TOKENS=900
MODEL_TEMPERATURE=0.1
